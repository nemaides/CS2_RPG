<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="CounterStrikeSharp.API" Version="*" />
		<PackageReference Include="CS2MenuManager" Version="1.0.43" />
		<PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="CS2_RPG.Skill.*\**" />
		<EmbeddedResource Remove="CS2_RPG.Skill.*\**" />
		<None Remove="CS2_RPG.Skill.*\**" />
	</ItemGroup>
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<Copy SourceFiles="$(TargetDir)$(TargetFileName)" DestinationFolder="I:\CS2Server\game\csgo\addons\counterstrikesharp\plugins\CS2_RPG" />
	</Target>
</Project>
